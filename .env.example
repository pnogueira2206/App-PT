DATABASE_URL="postgresql://user:password@localhost:5432/cfa_avaliacoes"
AUTH_SECRET="generate-a-long-random-string"

# Opcional — só necessário para o botão "Enviar por email ao treinador".
# Cria uma conta grátis em resend.com e copia a API key.
RESEND_API_KEY=""
# Remetente a usar nos emails. Enquanto não verificares um domínio próprio no
# Resend, usa "onboarding@resend.dev" — mas nesse modo só consegues enviar
# para o email da tua própria conta Resend, não para os treinadores reais.
RESEND_FROM_EMAIL="CFA Avaliações <onboarding@resend.dev>"

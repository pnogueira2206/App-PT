{
  "manifest_version": 3,
  "name": "CoachRx Athlete Panel",
  "version": "0.1.0",
  "description": "Side panel for CoachRx: template, priorities, season, zones and volume coverage per athlete.",
  "permissions": ["storage"],
  "host_permissions": ["https://dashboard.coachrx.app/*"],
  "content_scripts": [
    {
      "matches": ["https://dashboard.coachrx.app/*"],
      "js": ["src/storage.js", "src/api.js", "src/tabs.js", "src/coverage.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

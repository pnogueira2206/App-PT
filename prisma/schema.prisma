generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x: runtime of Netlify/AWS Lambda functions
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  TRAINER
  STUDENT
}

/// A block whose score feeds the student's records automatically.
enum BenchmarkKind {
  MAX_LOAD
  TIME
}

enum RecordType {
  WEIGHT
  TIME
}

enum WorkoutStatus {
  DRAFT
  PUBLISHED
}

enum WorkoutKind {
  TRAINING
  // Planned rest day: shown in calendars, never counted as missed.
  REST
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  DROPPED
}

enum BlockType {
  STRENGTH
  METCON
  ACCESSORY
  CARDIO
}

enum MetconFormat {
  FOR_TIME
  AMRAP
  EMOM
  FOR_REPS
  MAX_LOAD
}

enum CardioModality {
  ROW
  RUN
  BIKE
  SKI
  OTHER
}

enum ExerciseCategory {
  STRENGTH
  WEIGHTLIFTING
  GYMNASTICS
  CARDIO
  MOBILITY
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  // Archived students can't sign in and are left out of stats, alerts and pickers.
  archivedAt   DateTime?

  // Personal data (students)

  dateOfBirth  DateTime?
  weightKg     Float?
  heightCm     Float?

  // Trainer side
  groupsOwned       Group[]        @relation("TrainerGroups")
  exercisesCreated  Exercise[]     @relation("TrainerExercises")
  workoutsCreated   Workout[]      @relation("TrainerWorkouts")
  studentsCreated   User[]         @relation("TrainerStudents")
  trainer           User?          @relation("TrainerStudents", fields: [trainerId], references: [id])
  trainerId         String?

  // Student side
  memberships       GroupMember[]
  assignedWorkouts  Workout[]      @relation("StudentWorkouts")
  blockResults      BlockResult[]
  personalRecords   PersonalRecord[]
  completions       WorkoutCompletion[]
  resultComments    ResultComment[]
  trainingDays      TrainingDay[]
  notesAbout        CoachNote[]   @relation("NotesAbout")
  notesWritten      CoachNote[]   @relation("NotesWritten")
  goals             Goal[]
}

/** Weekly structure of a student or a group: the focus of each weekday ("Lower / Str - Squat ..."). */
model TrainingDay {
  id        String  @id @default(cuid())
  student   User?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String?
  group     Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String?
  // 0 = Monday ... 6 = Sunday
  weekday   Int
  focus     String

  @@unique([studentId, weekday])
  @@unique([groupId, weekday])
}

/** Private notes the trainer keeps about a student. */
model CoachNote {
  id        String   @id @default(cuid())
  student   User     @relation("NotesAbout", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  author    User     @relation("NotesWritten", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

model Goal {
  id         String     @id @default(cuid())
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  title      String
  notes      String?
  targetDate DateTime?
  status     GoalStatus @default(ACTIVE)
  achievedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([studentId, status])
}



model Group {
  id        String   @id @default(cuid())
  name      String
  trainer   User     @relation("TrainerGroups", fields: [trainerId], references: [id])
  trainerId String
  createdAt DateTime @default(now())

  members      GroupMember[]
  workouts     Workout[]
  trainingDays TrainingDay[]

}

model GroupMember {
  id        String   @id @default(cuid())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  addedAt   DateTime @default(now())

  @@unique([groupId, studentId])
}

model Exercise {
  id        String   @id @default(cuid())
  name      String
  category  ExerciseCategory @default(OTHER)
  videoUrl  String?
  notes     String?
  trainer   User     @relation("TrainerExercises", fields: [trainerId], references: [id])
  trainerId String
  createdAt DateTime @default(now())

  blocks           WorkoutBlock[]
  personalRecords  PersonalRecord[]

  @@unique([trainerId, name])
}

model Workout {
  id          String        @id @default(cuid())
  title       String
  description String?
  // Calendar day, stored as UTC midnight (see src/lib/dates.ts)
  date        DateTime
  status      WorkoutStatus @default(DRAFT)
  kind        WorkoutKind   @default(TRAINING)
  // Free-text warm-up and cooldown around the blocks (CoachRx-style workout).
  warmup      String?
  cooldown    String?
  trainer     User      @relation("TrainerWorkouts", fields: [trainerId], references: [id])
  trainerId   String
  group       Group?    @relation(fields: [groupId], references: [id])
  groupId     String?
  student     User?     @relation("StudentWorkouts", fields: [studentId], references: [id])
  studentId   String?
  // Set when this workout is an individual adjustment of a group workout
  sourceWorkout   Workout?  @relation("WorkoutOverrides", fields: [sourceWorkoutId], references: [id], onDelete: SetNull)
  sourceWorkoutId String?
  overrides       Workout[] @relation("WorkoutOverrides")
  createdAt   DateTime  @default(now())

  blocks      WorkoutBlock[]
  completions WorkoutCompletion[]

  @@index([studentId, date])
  @@index([groupId, date])
}

model WorkoutCompletion {
  id          String   @id @default(cuid())
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  sessionRpe  Int?
  notes       String?
  completedAt DateTime @default(now())
  // When the trainer last saw this completion; cleared when the student edits it.
  seenAt      DateTime?

  @@unique([workoutId, studentId])
}

model WorkoutBlock {
  id                String   @id @default(cuid())
  workout           Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId         String
  order             Int
  type              BlockType @default(STRENGTH)
  title             String
  exercise          Exercise? @relation(fields: [exerciseId], references: [id])
  exerciseId        String?
  // Free description (WOD, circuit, cardio intervals...)
  description       String?

  // Strength
  prescribedSets    Int?
  prescribedReps    String?
  prescribedWeight  String?
  percent1RM        Float?
  tempo             String?
  restSeconds       Int?

  // Metcon
  metconFormat      MetconFormat?
  // Time cap (For Time) or duration (AMRAP/EMOM)
  timeCapSeconds    Int?

  // Cardio
  cardioModality    CardioModality?
  targetDistanceM   Int?
  targetTimeSeconds Int?
  targetCalories    Int?
  targetPace        String?

  trainerNotes      String?

  // Benchmark: the student logs one number (kg or time) and the record updates itself.
  benchmark         BenchmarkKind?
  /// MAX_LOAD only: 1 for a 1RM, 3 for a 3RM...
  benchmarkReps     Int?

  results           BlockResult[]
}

model BlockResult {
  id             String       @id @default(cuid())
  block          WorkoutBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  blockId        String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String
  done           Boolean      @default(true)
  timeSeconds    Int?
  rounds         Int?
  reps           Int?
  loadKg         Float?
  distanceM      Float?
  calories       Int?
  rx             Boolean?
  rpe            Int?
  // Free-text alternative to the structured score
  scoreText      String?
  studentNotes   String?
  completedAt    DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  // When the trainer last saw this result; cleared when the student edits it.
  seenAt         DateTime?

  sets           SetLog[]
  comments       ResultComment[]
  records        PersonalRecord[]


  @@unique([blockId, studentId])
  @@index([studentId, updatedAt])
}

model ResultComment {
  id        String      @id @default(cuid())
  result    BlockResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  resultId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime    @default(now())
  // When the other person (trainer or student) read it.
  readAt    DateTime?

  @@index([resultId, createdAt])
}

model SetLog {
  id        String      @id @default(cuid())
  result    BlockResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  resultId  String
  setNumber Int
  reps      Int?
  loadKg    Float?
}

model PersonalRecord {
  id          String   @id @default(cuid())
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId  String
  type        RecordType @default(WEIGHT)
  value       String
  unit        String?
  /// Weight records: the reps of the lift (3 = 3RM). Null for older records (treated as 1RM).
  reps        Int?
  notes       String?
  recordDate  DateTime @default(now())
  createdAt   DateTime @default(now())
  // Set when the record was saved from a workout result (shows 🏆 in the feed).
  sourceResult   BlockResult? @relation(fields: [sourceResultId], references: [id], onDelete: SetNull)
  sourceResultId String?
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  AVALIADOR
  TREINADOR
}

enum TipoResposta {
  PONTOS
  TEXTO_LIVRE
}

enum Pilar {
  ENSINAR
  VER
  CORRIGIR
  GESTAO_GRUPO
  PRESENCA_ATITUDE
  DEMONSTRACAO
}

model Utilizador {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  passwordHash String
  papel        Papel
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())

  avaliacoesComoTreinador Avaliacao[] @relation("AvaliacaoTreinador")
  avaliacoesComoAvaliador Avaliacao[] @relation("AvaliacaoAvaliador")
}

model TipoAula {
  id    String  @id @default(cuid())
  nome  String
  ativo Boolean @default(true)

  avaliacoes Avaliacao[]
}

model Seccao {
  id          String     @id @default(cuid())
  nome        String
  percentagem Int
  ativa       Boolean    @default(true)
  ordem       Int
  criterios   Criterio[]
}

model Criterio {
  id           String       @id @default(cuid())
  seccao       Seccao       @relation(fields: [seccaoId], references: [id], onDelete: Cascade)
  seccaoId     String
  texto        String
  pesoMaximo   Float?
  tipoResposta TipoResposta
  dimensao     String?
  ativo        Boolean      @default(true)
  ordem        Int

  pilares CriterioPilar[]
}

model CriterioPilar {
  criterio   Criterio @relation(fields: [criterioId], references: [id], onDelete: Cascade)
  criterioId String
  pilar      Pilar

  @@id([criterioId, pilar])
}

model Avaliacao {
  id String @id @default(cuid())

  treinador   Utilizador @relation("AvaliacaoTreinador", fields: [treinadorId], references: [id])
  treinadorId String
  avaliador   Utilizador @relation("AvaliacaoAvaliador", fields: [avaliadorId], references: [id])
  avaliadorId String
  espaco      String
  tipoAula    TipoAula   @relation(fields: [tipoAulaId], references: [id])
  tipoAulaId  String
  data        String
  hora        String
  nAlunos     Int

  /// JSON: Record<criterioId, { tipo, valor?, na?, texto? }>
  respostas String
  /// JSON: Record<seccaoId, string>
  observacoes String
  /// JSON: cópia da grelha (secções ativas + critérios) no momento em que foi preenchida
  grelhaSnapshot String

  classificacaoGeral Int
  comentarioGeral    String

  /// JSON: { origem: string; texto: string }[] — plano de ação desta avaliação
  planoAcao String @default("[]")

  confirmacaoAvaliadorData String?
  confirmacaoTreinadorData String?

  guardadaEm DateTime @default(now())
}
